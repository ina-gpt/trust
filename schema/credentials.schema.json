{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ina-gpt/trust/schema/credentials.schema.json",
  "title": "INA GPT GmbH trust and compliance register",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization", "registrations", "certifications", "memberships", "practices", "contact"],
  "$defs": {
    "status": {
      "enum": ["held", "in_progress", "applied", "verification_pending"]
    },
    "date": { "type": "string", "format": "date" },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "entryBase": {
      "type": "object",
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 3 },
        "status": { "$ref": "#/$defs/status" }
      }
    }
  },
  "properties": {
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_name", "platform_name", "address", "email", "phone",
        "founded", "website", "data_processing_location", "compute_statement"
      ],
      "properties": {
        "legal_name": { "type": "string", "minLength": 3 },
        "platform_name": { "type": "string", "minLength": 2 },
        "address": { "type": "string", "minLength": 10 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "pattern": "^\\+[0-9 ]{8,20}$" },
        "founded": { "type": "string", "pattern": "^[0-9]{4}$" },
        "website": { "$ref": "#/$defs/url" },
        "data_processing_location": { "type": "string", "minLength": 3 },
        "compute_statement": { "type": "string", "minLength": 3 }
      }
    },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "identifier", "issuer", "evidence_url", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 3 },
          "identifier": { "type": "string", "minLength": 3 },
          "issuer": { "type": "string", "minLength": 3 },
          "evidence_url": { "$ref": "#/$defs/url" },
          "status": { "$ref": "#/$defs/status" }
        }
      }
    },
    "certifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "issuer"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 3 },
          "status": { "$ref": "#/$defs/status" },
          "issuer": { "type": "string", "minLength": 3 },
          "identifier": { "type": "string", "minLength": 3 },
          "scope_en": { "type": "string", "minLength": 3 },
          "scope_de": { "type": "string", "minLength": 3 },
          "valid_from": { "$ref": "#/$defs/date" },
          "valid_to": { "$ref": "#/$defs/date" },
          "statement_of_applicability": { "type": "string", "minLength": 2 },
          "evidence_url": { "$ref": "#/$defs/url" },
          "fundstelle_required": { "type": "boolean" },
          "stage": { "type": "string", "minLength": 3 },
          "since": { "$ref": "#/$defs/date" },
          "declared_roles": { "type": "string", "minLength": 3 },
          "note": { "type": "string", "minLength": 3 }
        }
      }
    },
    "memberships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 3 },
          "status": { "$ref": "#/$defs/status" },
          "identifier": { "type": "string", "minLength": 3 },
          "category": { "type": "string", "minLength": 3 },
          "since": { "$ref": "#/$defs/date" },
          "evidence_url": {
            "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }]
          },
          "logo": { "type": "string", "pattern": "^logos/[A-Za-z0-9._-]+$" },
          "reason": { "type": "string", "minLength": 3 },
          "detail": { "type": "string", "minLength": 3 }
        }
      }
    },
    "practices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 3 },
          "body": { "type": "string", "minLength": 20 }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "security_policy_url", "canonical_url", "preferred_languages"],
      "properties": {
        "security": { "type": "string", "format": "email" },
        "security_role_address": { "type": "string", "format": "email" },
        "security_policy_url": { "$ref": "#/$defs/url" },
        "acknowledgments_url": { "$ref": "#/$defs/url" },
        "hiring_url": { "$ref": "#/$defs/url" },
        "canonical_url": { "$ref": "#/$defs/url" },
        "preferred_languages": { "type": "string", "minLength": 2 }
      }
    }
  }
}
