{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ina-gpt/trust/schema/credentials.schema.json",
  "title": "INA GPT GmbH trust and compliance register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization",
    "registrations",
    "certifications",
    "memberships",
    "practices",
    "contact",
    "marks"
  ],
  "$defs": {
    "status": {
      "enum": [
        "held",
        "in_progress",
        "applied",
        "verification_pending"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "entryBase": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence_tier": {
          "description": "public_registry: evidence_url is a primary source anyone can open. document_on_request: the evidence is a named, dated document held privately and produced on request. A held credential must satisfy one of the two.",
          "enum": [
            "public_registry",
            "document_on_request"
          ]
        },
        "document_ref": {
          "description": "For document_on_request: the document's name AND its date. A reference without a date is not a reference.",
          "type": "string",
          "minLength": 12
        }
      }
    }
  },
  "properties": {
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_name",
        "platform_name",
        "address",
        "email",
        "phone",
        "founded",
        "website",
        "data_processing_location",
        "compute_statement"
      ],
      "properties": {
        "legal_name": {
          "type": "string",
          "minLength": 3
        },
        "platform_name": {
          "type": "string",
          "minLength": 2
        },
        "address": {
          "type": "string",
          "minLength": 10
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[0-9 ]{8,20}$"
        },
        "founded": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "website": {
          "$ref": "#/$defs/url"
        },
        "data_processing_location": {
          "type": "string",
          "minLength": 3
        },
        "compute_statement": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "identifier",
          "issuer",
          "evidence_url",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "identifier": {
            "type": "string",
            "minLength": 3
          },
          "issuer": {
            "type": "string",
            "minLength": 3
          },
          "evidence_url": {
            "$ref": "#/$defs/url"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "machine_checkable": {
            "type": "boolean"
          },
          "machine_checkable_reason": {
            "type": "string",
            "minLength": 10
          },
          "last_human_verified": {
            "$ref": "#/$defs/date"
          },
          "human_verified_by": {
            "type": "string",
            "minLength": 2
          },
          "evidence_tier": {
            "description": "public_registry: evidence_url is a primary source anyone can open. document_on_request: the evidence is a named, dated document held privately and produced on request. A held credential must satisfy one of the two.",
            "enum": [
              "public_registry",
              "document_on_request"
            ]
          },
          "document_ref": {
            "description": "For document_on_request: the document's name AND its date. A reference without a date is not a reference.",
            "type": "string",
            "minLength": 12
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "issuer"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "issuer": {
            "type": "string",
            "minLength": 3
          },
          "identifier": {
            "type": "string",
            "minLength": 3
          },
          "scope_en": {
            "type": "string",
            "minLength": 3
          },
          "scope_de": {
            "type": "string",
            "minLength": 3
          },
          "valid_from": {
            "$ref": "#/$defs/date"
          },
          "valid_to": {
            "$ref": "#/$defs/date"
          },
          "statement_of_applicability": {
            "type": "string",
            "minLength": 2
          },
          "evidence_url": {
            "$ref": "#/$defs/url"
          },
          "fundstelle_required": {
            "type": "boolean"
          },
          "stage": {
            "type": "string",
            "minLength": 3
          },
          "since": {
            "$ref": "#/$defs/date"
          },
          "declared_roles": {
            "type": "string",
            "minLength": 3
          },
          "note": {
            "type": "string",
            "minLength": 3
          },
          "fundstelle_url": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "$ref": "#/$defs/url"
              },
              "de": {
                "$ref": "#/$defs/url"
              }
            }
          },
          "machine_checkable": {
            "type": "boolean"
          },
          "machine_checkable_reason": {
            "type": "string",
            "minLength": 10
          },
          "last_human_verified": {
            "$ref": "#/$defs/date"
          },
          "human_verified_by": {
            "type": "string",
            "minLength": 2
          },
          "evidence_tier": {
            "description": "public_registry: evidence_url is a primary source anyone can open. document_on_request: the evidence is a named, dated document held privately and produced on request. A held credential must satisfy one of the two.",
            "enum": [
              "public_registry",
              "document_on_request"
            ]
          },
          "document_ref": {
            "description": "For document_on_request: the document's name AND its date. A reference without a date is not a reference.",
            "type": "string",
            "minLength": 12
          }
        }
      }
    },
    "memberships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "identifier": {
            "type": "string",
            "minLength": 3
          },
          "category": {
            "type": "string",
            "minLength": 3
          },
          "since": {
            "$ref": "#/$defs/date"
          },
          "evidence_url": {
            "oneOf": [
              {
                "$ref": "#/$defs/url"
              },
              {
                "type": "null"
              }
            ]
          },
          "logo": {
            "type": "string",
            "pattern": "^logos/[A-Za-z0-9._-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 3
          },
          "detail": {
            "type": "string",
            "minLength": 3
          },
          "machine_checkable": {
            "type": "boolean"
          },
          "machine_checkable_reason": {
            "type": "string",
            "minLength": 10
          },
          "last_human_verified": {
            "$ref": "#/$defs/date"
          },
          "human_verified_by": {
            "type": "string",
            "minLength": 2
          },
          "evidence_tier": {
            "description": "public_registry: evidence_url is a primary source anyone can open. document_on_request: the evidence is a named, dated document held privately and produced on request. A held credential must satisfy one of the two.",
            "enum": [
              "public_registry",
              "document_on_request"
            ]
          },
          "document_ref": {
            "description": "For document_on_request: the document's name AND its date. A reference without a date is not a reference.",
            "type": "string",
            "minLength": 12
          }
        }
      }
    },
    "practices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "body": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security",
        "security_policy_url",
        "canonical_url",
        "preferred_languages"
      ],
      "properties": {
        "security": {
          "type": "string",
          "format": "email"
        },
        "security_role_address": {
          "type": "string",
          "format": "email"
        },
        "security_policy_url": {
          "$ref": "#/$defs/url"
        },
        "acknowledgments_url": {
          "$ref": "#/$defs/url"
        },
        "hiring_url": {
          "$ref": "#/$defs/url"
        },
        "canonical_url": {
          "$ref": "#/$defs/url"
        },
        "preferred_languages": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "marks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "credential_ref",
          "file",
          "sha256",
          "grantor",
          "grantor_role",
          "permission_date",
          "permission_evidence",
          "source_url",
          "usage_constraints",
          "surfaces"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "display_name": {
            "type": "string",
            "minLength": 3
          },
          "credential_ref": {
            "$ref": "#/$defs/id"
          },
          "file": {
            "type": "string",
            "pattern": "^logos/[A-Za-z0-9._-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "grantor": {
            "type": "string",
            "minLength": 3
          },
          "grantor_role": {
            "type": "string",
            "minLength": 3
          },
          "permission_date": {
            "$ref": "#/$defs/date"
          },
          "permission_evidence": {
            "type": "string",
            "minLength": 20
          },
          "source_url": {
            "$ref": "#/$defs/url"
          },
          "usage_constraints": {
            "type": "string",
            "minLength": 10
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "site_footer",
                "trust_repo",
                "org_profile"
              ]
            }
          },
          "site_path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._/@-]+$"
          },
          "render": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ink_fraction",
              "ink_coverage",
              "source_ratio",
              "box_height_px",
              "sizing",
              "measured_at",
              "method"
            ],
            "properties": {
              "ink_fraction": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "ink_coverage": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "source_ratio": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "box_height_px": {
                "type": "integer",
                "minimum": 8,
                "maximum": 400
              },
              "sizing": {
                "enum": [
                  "ink-normalised",
                  "width-capped"
                ]
              },
              "measured_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "method": {
                "type": "string",
                "minLength": 40
              }
            }
          }
        }
      }
    },
    "mark_render_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ink_px",
        "max_width_px",
        "coverage_boost_exponent",
        "coverage_boost_max",
        "coverage_reference",
        "formula"
      ],
      "properties": {
        "target_ink_px": {
          "type": "number",
          "minimum": 8,
          "maximum": 200
        },
        "max_width_px": {
          "type": "number",
          "minimum": 24,
          "maximum": 600
        },
        "coverage_boost_exponent": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coverage_boost_max": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "coverage_reference": {
          "type": "string",
          "minLength": 3
        },
        "formula": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
